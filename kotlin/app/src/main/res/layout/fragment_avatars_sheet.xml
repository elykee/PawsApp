<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottomsheet_bg"
    android:padding="15dp">

    <!-- Título -->
    <TextView
        android:id="@+id/avatars_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="90dp"
        android:text="@string/avatars_title"
        android:textColor="@color/nav_icon_color"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/close_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botón de cerrar esquina superior derecha -->
    <ImageButton
        android:id="@+id/close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@id/avatars_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/nav_icon_color"
        android:contentDescription="@string/btn_close_avatars"/>

    <!-- Contenedor de avatares -->
    <FrameLayout
        android:id="@+id/avatars_container"
        android:layout_width="match_parent"
        android:layout_height="532dp"
        android:layout_marginTop="5dp"
        android:padding="35dp"
        app:layout_constraintTop_toBottomOf="@id/close_button">

        <ImageButton
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="top|start"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/dog1"
            android:contentDescription="@string/btn_avatar1"/>

        <ImageButton
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="top|end"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/dog2"
            android:contentDescription="@string/bnt_avatar2"/>

        <ImageButton
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="start|center"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/shibainu"
            android:contentDescription="@string/btn_avatar_shibainu"/>

        <ImageButton
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="end|center"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/border_collie"
            android:contentDescription="@string/btn_avatar_bordercollie"/>

        <ImageButton
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="bottom|start"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/dog3"
            android:contentDescription="@string/btn_avatar3"/>

        <!-- Botón Avatar Premium -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/circular_button"
            android:padding="15dp">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center|top"
                android:layout_marginTop="15dp"
                android:src="@drawable/ic_premium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:text="@string/premium_text"
                android:textAlignment="center"
                android:textColor="@color/bg_color"
                android:textSize="14sp"
                android:textStyle="bold" />

        </FrameLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>