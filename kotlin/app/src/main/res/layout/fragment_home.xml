<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StartFreeActivity">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Fondo amarillo superior -->
        <View
            android:id="@+id/bg_shape_top"
            android:layout_width="724dp"
            android:layout_height="362dp"
            android:background="@drawable/background_shape"
            android:translationY="-215dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="87dp"
            android:layout_height="24dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/logo"
            app:layout_constraintBottom_toBottomOf="@id/notification_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Botón icono notificaciones -->
        <ImageButton
            android:id="@+id/notification_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="18dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="@string/btn_notification"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/notification_button"
            app:layout_constraintBottom_toBottomOf="@id/logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- Botón avatar -->
        <FrameLayout
            android:id="@+id/avatar_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="@string/btn_user_avatar"
            app:layout_constraintTop_toBottomOf="@id/logo">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatar_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar"
                android:importantForAccessibility="no"
                app:shapeAppearanceOverlay="@style/CircleAvatarStyle" />

            <ImageView
                android:id="@+id/edit_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_edit" />

        </FrameLayout>


        <!-- Header h1 -->
        <TextView
            android:id="@+id/welcome_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="235dp"
            android:gravity="center"
            android:text="@string/welcome_title"
            android:textColor="@color/txt_primary_color"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/avatar_button_container"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header h2 -->
        <TextView
            android:id="@+id/login_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/login_title"
            android:textColor="@color/txt_primary_color"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_title" />

        <!-- Sección Pets-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pets_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_title">

            <TextView
                android:id="@+id/pets_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pets"
                android:textColor="@color/txt_primary_color"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="12dp"
                android:background="@color/line_decorator"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/pets_title"
                app:layout_constraintTop_toTopOf="@id/pets_title" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pets_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/pets_title">

                <ImageView
                    android:id="@+id/husky"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/husky"
                    android:text="@string/husky"
                    app:layout_constraintEnd_toStartOf="@id/border_collie"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/husky"
                    android:textColor="@color/txt_primary_color"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toStartOf="@id/border_collie"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/husky" />

                <ImageView
                    android:id="@+id/border_collie"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/border_collie"
                    app:layout_constraintEnd_toStartOf="@id/galgo"
                    app:layout_constraintStart_toEndOf="@id/husky"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/border_collie"
                    android:textColor="@color/txt_primary_color"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toStartOf="@id/galgo"
                    app:layout_constraintStart_toEndOf="@id/husky"
                    app:layout_constraintTop_toBottomOf="@id/border_collie" />

                <ImageView
                    android:id="@+id/galgo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/galgo"
                    app:layout_constraintEnd_toStartOf="@id/shibainu"
                    app:layout_constraintStart_toEndOf="@id/border_collie"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/galgo"
                    android:textColor="@color/txt_primary_color"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toStartOf="@id/shibainu"
                    app:layout_constraintStart_toEndOf="@id/border_collie"
                    app:layout_constraintTop_toBottomOf="@id/galgo" />

                <ImageView
                    android:id="@+id/shibainu"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/shibainu"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/galgo"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/shibainu"
                    android:textColor="@color/txt_primary_color"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/galgo"
                    app:layout_constraintTop_toBottomOf="@id/shibainu" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Sección Events -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/events_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pets_container">

            <TextView
                android:id="@+id/events_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/events"
                android:textColor="@color/txt_primary_color"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="12dp"
                android:background="@color/line_decorator"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/events_title"
                app:layout_constraintTop_toTopOf="@id/events_title" />

            <View
                android:id="@+id/events_box"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/rounded_dotted_border"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/events_title" />

            <!-- Botón add para añadir recordatorios, citas, eventos importantes -->
            <ImageView
                android:id="@+id/add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:src="@drawable/ic_plus"
                app:layout_constraintEnd_toEndOf="@id/events_box"
                app:layout_constraintStart_toStartOf="@id/events_box"
                app:layout_constraintTop_toTopOf="@id/events_box"
                app:tint="@color/login_button_color" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:paddingHorizontal="30dp"
                android:text="@string/events_info"
                android:textAlignment="center"
                android:textColor="@color/login_button_color"
                app:layout_constraintBottom_toBottomOf="@id/events_box"
                app:layout_constraintEnd_toEndOf="@id/events_box"
                app:layout_constraintStart_toStartOf="@id/events_box"
                app:layout_constraintTop_toBottomOf="@id/add" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Sección For you-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/for_you_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/events_container">

            <TextView
                android:id="@+id/for_you_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/for_you"
                android:textColor="@color/txt_primary_color"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="12dp"
                android:background="@color/line_decorator"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/for_you_title"
                app:layout_constraintTop_toTopOf="@id/for_you_title" />

            <!-- Botón Tips (Consejos/Sugerencias) -->
            <View
                android:id="@+id/tips_button"
                android:layout_width="0dp"
                android:layout_height="75dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/rectangle_button_bg"
                app:layout_constraintEnd_toStartOf="@id/news_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/for_you_title" />

            <ImageView
                android:id="@+id/tips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:src="@drawable/tips"
                app:layout_constraintEnd_toEndOf="@id/tips_button"
                app:layout_constraintStart_toStartOf="@id/tips_button"
                app:layout_constraintTop_toTopOf="@id/tips_button" />

            <TextView
                android:id="@+id/tips_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/tips"
                android:textAlignment="center"
                android:textColor="@color/bg_color"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tips_button"
                app:layout_constraintEnd_toEndOf="@id/tips_button"
                app:layout_constraintStart_toStartOf="@id/tips_button" />

            <!-- Botón News (Noticias) -->
            <View
                android:id="@+id/news_button"
                android:layout_width="0dp"
                android:layout_height="75dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/rectangle_button_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tips_button"
                app:layout_constraintTop_toBottomOf="@id/for_you_title" />

            <ImageView
                android:id="@+id/news"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:src="@drawable/news"
                app:layout_constraintEnd_toEndOf="@id/news_button"
                app:layout_constraintStart_toStartOf="@id/news_button"
                app:layout_constraintTop_toTopOf="@id/news_button" />

            <TextView
                android:id="@+id/news_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/news"
                android:textAlignment="center"
                android:textColor="@color/bg_color"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/news_button"
                app:layout_constraintEnd_toEndOf="@id/news_button"
                app:layout_constraintStart_toStartOf="@id/news_button" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>




