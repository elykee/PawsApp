<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PetsFragment">


    <!-- Fondo amarillo superior -->
    <View
        android:id="@+id/bg_shape_top"
        android:layout_width="724dp"
        android:layout_height="362dp"
        android:background="@drawable/background_shape"
        android:translationY="-215dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header h1 -->
    <TextView
        android:id="@+id/pets_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/pets_title"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header h2 -->
    <TextView
        android:id="@+id/pets_text"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingHorizontal="10dp"
        android:text="@string/pets_text"
        android:textAlignment="center"
        android:textColor="@color/bg_color"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pets_title" />

    <!-- Contenedor de pets -->
    <GridLayout
        android:id="@+id/pets_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:columnCount="2"
        android:rowCount="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pets_text">

        <!-- Fila 1 - Columna 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp">

            <ImageButton
                android:id="@+id/husky"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/husky"
                android:contentDescription="@string/btn_latte_profile"
                />

            <TextView
                android:id="@+id/latte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/husky"
                android:textColor="@color/txt_primary_color"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Fila 2 - Columna 2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp">

            <ImageButton
                android:id="@+id/border_collie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/border_collie"
                android:contentDescription="@string/btn_milkshake_profile"/>

            <TextView
                android:id="@+id/milkshake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/border_collie"
                android:textColor="@color/txt_primary_color"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Fila 1 - Columna 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp">

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/galgo"
                android:contentDescription="@string/btn_mozart_profile"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/galgo"
                android:textColor="@color/nav_icon_color"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Fila 2 - Columna 2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp">

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/shibainu"
                android:contentDescription="@string/btn_banana_profile"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/shibainu"
                android:textColor="@color/nav_icon_color"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Fila 3 - Columna 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp">

            <FrameLayout
                android:id="@+id/pet_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pet_add"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/bnt_add_pet">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plus" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/pets_add"
                android:textColor="@color/nav_icon_color"
                android:textSize="16sp" />
        </LinearLayout>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>